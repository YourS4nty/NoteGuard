<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content="View a NoteGuard note."><link rel="shortcut icon" href="../media/NoteGuard.ico" type="image/x-icon"><title>NoteGuard — <%= note.title %></title><style>*{box-sizing:border-box;margin:0;padding:0}:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#f8f7ff}body{min-height:100vh;padding:28px 18px;background:radial-gradient(circle at 15% 15%,rgba(127,90,240,.2),transparent 34%),radial-gradient(circle at 85% 85%,rgba(98,70,183,.16),transparent 32%),#0b0a10}.shell{width:min(820px,100%);margin:0 auto}.glass{border:1px solid rgba(255,255,255,.11);border-radius:28px;background:linear-gradient(135deg,rgba(36,38,41,.72),rgba(22,22,26,.55));box-shadow:0 24px 70px rgba(0,0,0,.48),inset 0 1px rgba(255,255,255,.07);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);padding:clamp(24px,5vw,46px)}.topbar{display:flex;justify-content:flex-end;margin:-8px -8px 14px}.language{display:flex;gap:4px;padding:5px;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.045);color:#9b9daa;font:inherit;font-size:.75rem;cursor:pointer}.language span{padding:5px 7px;border-radius:8px}.language .active{background:rgba(127,90,240,.22);color:#fff}.brand{display:flex;align-items:center;gap:12px;margin-bottom:34px}.logo{width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(135deg,#7f5af0,#6246b7);font-weight:800;box-shadow:0 10px 28px rgba(127,90,240,.3)}.brand strong{font-size:1.05rem}.brand span{display:block;color:#777985;font-size:.78rem;margin-top:2px}.eyebrow{color:#a995ff;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:9px}h1{font-size:clamp(1.8rem,5vw,2.8rem);letter-spacing:-.04em;line-height:1.1;margin-bottom:22px;overflow-wrap:anywhere}.content-label{color:#777985;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px}.content{width:100%;min-height:300px;resize:vertical;padding:18px;border:1px solid rgba(255,255,255,.09);border-radius:17px;background:rgba(10,10,15,.62);color:#eeeef5;font:inherit;line-height:1.7;outline:none;margin-bottom:22px}.meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-bottom:24px}.meta-card{padding:15px;border-radius:15px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07)}.meta-card span{display:block;color:#777985;font-size:.75rem;margin-bottom:5px}.meta-card strong{font-size:.9rem;color:#dedee7}.protected{color:#b8aaff!important}.expiry{color:#f0a6aa!important}.actions{display:flex;gap:10px;flex-wrap:wrap}.actions a{min-height:46px;padding:0 17px;border-radius:13px;text-decoration:none;font-weight:700;display:inline-flex;align-items:center;justify-content:center;transition:.2s}.primary{background:linear-gradient(135deg,#8b6cff,#6c4fe1);color:#fff;box-shadow:0 10px 24px rgba(127,90,240,.25)}.secondary{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.1);color:#dedee7}.actions a:hover{transform:translateY(-1px)}a:focus-visible,button:focus-visible{outline:2px solid #a995ff;outline-offset:3px}@media(max-width:560px){body{padding:14px 12px}.glass{padding:20px 18px;border-radius:22px}.meta{grid-template-columns:1fr}.actions{display:grid}.actions a{width:100%}.content{min-height:240px}}</style></head><body><main class="shell"><section class="glass"><div class="topbar"><button class="language" type="button" data-language-toggle onclick="toggleNoteGuardLanguage()" aria-label="Language"><span data-lang-en>EN</span><span data-lang-es>ES</span></button></div><div class="brand"><div class="logo" aria-hidden="true">N</div><div><strong>NoteGuard</strong><span data-i18n="brand.tagline">Private notes, on your terms.</span></div></div><div class="eyebrow" data-i18n="note.eyebrow">Secure note</div><h1><%= note.title %></h1><div class="content-label" data-i18n="note.contentLabel">Note content · click to copy</div><textarea class="content" id="note-content" readonly aria-label="Note content"><%= note.content %></textarea><div class="meta"><div class="meta-card"><span data-i18n="note.protection">Protection</span><strong class="protected" data-i18n><%= note.password ? 'Password protected' : 'Not protected' %></strong></div><div class="meta-card"><span data-i18n="note.expiration">Expiration</span><strong class="expiry"><%= note.expirationDate %></strong></div></div><div class="actions"><a class="primary" href="/"><span data-i18n="note.createAnother">Create another note</span> →</a><a class="secondary" href="/viewById" data-i18n="note.findAnother">Find another note</a></div></section><footer><span data-i18n="footer.made">Made with</span> <span aria-hidden="true">♥</span> by <a href="https://Your4Portfolio.vercel.app">YourS4nty</a></footer></main><script>const content=document.getElementById('note-content');content.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(content.value);const label=document.querySelector('.content-label');const original=label.textContent;label.textContent=window.noteGuardLanguage&&window.noteGuardLanguage()==='es'?'Copiado al portapapeles ✓':'Copied to clipboard ✓';setTimeout(()=>label.textContent=original,1600)}catch(e){content.select();document.execCommand('copy')}});</script><script src="/media/i18n.js"></script></body></html>