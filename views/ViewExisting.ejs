<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content="Find an existing NoteGuard note by its ID."><link rel="shortcut icon" href="../media/NoteGuard.ico" type="image/x-icon"><title>NoteGuard — Find a Note</title><style>*{box-sizing:border-box;margin:0;padding:0}:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#f8f7ff;background:#0b0a10}body{min-height:100vh;display:grid;place-items:center;padding:24px;background:radial-gradient(circle at 20% 20%,rgba(127,90,240,.2),transparent 35%),radial-gradient(circle at 80% 80%,rgba(98,70,183,.16),transparent 32%),#0b0a10}.shell{width:min(620px,100%)}.glass{padding:clamp(25px,6vw,48px);border:1px solid rgba(255,255,255,.11);border-radius:28px;background:linear-gradient(135deg,rgba(36,38,41,.72),rgba(22,22,26,.55));box-shadow:0 24px 70px rgba(0,0,0,.48),inset 0 1px rgba(255,255,255,.07);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px)}.topbar{display:flex;justify-content:flex-end;margin:-8px -8px 12px}.language{display:flex;align-items:center;gap:4px;padding:5px;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.045);color:#9b9daa;font:inherit;font-size:.75rem;cursor:pointer}.language span{padding:5px 7px;border-radius:8px}.language .active{background:rgba(127,90,240,.22);color:#fff}.brand{display:flex;align-items:center;gap:12px;margin-bottom:36px}.logo{width:44px;height:44px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(135deg,#7f5af0,#6246b7);font-weight:800;box-shadow:0 10px 28px rgba(127,90,240,.3)}.brand strong{font-size:1.05rem}.brand span{display:block;color:#777985;font-size:.78rem;margin-top:2px}.eyebrow{color:#a995ff;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:9px}h1{font-size:clamp(2rem,5vw,2.8rem);letter-spacing:-.04em;margin-bottom:10px}.intro{color:#aeb0bb;line-height:1.6;margin-bottom:28px}.message{padding:13px 15px;border-radius:14px;margin-bottom:18px;font-size:.9rem}.error{background:rgba(239,68,68,.1);color:#ffb4b4;border:1px solid rgba(239,68,68,.25)}.success{background:rgba(74,222,128,.08);color:#b9f7ca;border:1px solid rgba(74,222,128,.2)}form{display:grid;gap:10px}label{color:#c4c5ce;font-size:.88rem;font-weight:600}input{width:100%;padding:14px;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(10,10,15,.62);color:#fff;outline:none;font:inherit;transition:.2s}input:focus{border-color:rgba(127,90,240,.75);box-shadow:0 0 0 4px rgba(127,90,240,.13)}button,.back{min-height:46px;border-radius:13px;font:inherit;font-weight:700;cursor:pointer;text-decoration:none;display:flex;align-items:center;justify-content:center;transition:.2s}.button{border:0;background:linear-gradient(135deg,#8b6cff,#6c4fe1);color:#fff;box-shadow:0 10px 24px rgba(127,90,240,.25);margin-top:7px}.back{border:1px solid rgba(255,255,255,.1);color:#dedee7;background:rgba(255,255,255,.045);margin-top:2px}.button:hover,.back:hover{transform:translateY(-1px)}button:focus-visible,a:focus-visible,.language:focus-visible{outline:2px solid #a995ff;outline-offset:3px}footer{text-align:center;color:#686a76;font-size:.78rem;margin-top:18px}footer a{color:#9b87ff;text-decoration:none}@media(max-width:560px){body{padding:14px}.glass{border-radius:22px;padding:20px 18px}.topbar{margin:-2px 0 10px}}</style></head><body><main class="shell"><section class="glass"><div class="topbar"><button class="language" type="button" data-language-toggle onclick="toggleNoteGuardLanguage()" aria-label="Language"><span data-lang-en>EN</span><span data-lang-es>ES</span></button></div><div class="brand"><div class="logo" aria-hidden="true">N</div><div><strong>NoteGuard</strong><span data-i18n="brand.tagline">Private notes, on your terms.</span></div></div><div class="eyebrow" data-i18n="view.eyebrow">Retrieve a note</div><h1 data-i18n="view.title">Find your note.</h1><p class="intro" data-i18n="view.intro">Enter the note ID you received when the note was created.</p><% if (error) { %><div class="message error" data-i18n-error role="alert"><%= error %></div><% } else if (success) { %><div class="message success" data-i18n-error role="status"><%= success %></div><% } %><form id="viewNoteForm" method="get"><label for="noteId" data-i18n="view.idLabel">Note ID</label><input type="text" id="noteId" name="noteId" data-i18n-placeholder="view.idPlaceholder" placeholder="Paste your note ID" autocomplete="off" required><button class="button" type="button" onclick="submitForm()"><span data-i18n="view.button">View note</span> <span aria-hidden="true">→</span></button><a class="back" href="/">← <span data-i18n="view.back">Back to create note</span></a></form></section><footer><span data-i18n="footer.made">Made with</span> <span aria-hidden="true">♥</span> by <a href="https://Your4Portfolio.vercel.app">YourS4nty</a></footer></main><script>function submitForm(){const id=document.getElementById("noteId").value.trim();if(!id)return;document.getElementById("viewNoteForm").action="/note/"+encodeURIComponent(id);document.getElementById("viewNoteForm").submit();}</script><script src="/media/i18n.js"></script></body></html>