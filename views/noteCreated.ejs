<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content="Your NoteGuard note was created successfully."><link rel="shortcut icon" href="../media/NoteGuard.ico" type="image/x-icon"><title>NoteGuard — Note Created</title>
  <style>*{box-sizing:border-box;margin:0;padding:0}:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#f8f7ff}body{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 20% 15%,rgba(127,90,240,.2),transparent 35%),radial-gradient(circle at 80% 85%,rgba(98,70,183,.16),transparent 32%),#0b0a10}.card{width:min(650px,100%);padding:clamp(25px,6vw,48px);border:1px solid rgba(255,255,255,.11);border-radius:28px;background:linear-gradient(135deg,rgba(36,38,41,.72),rgba(22,22,26,.55));box-shadow:0 24px 70px rgba(0,0,0,.48),inset 0 1px rgba(255,255,255,.07);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px)}.success-icon{width:56px;height:56px;display:grid;place-items:center;border-radius:17px;background:rgba(74,222,128,.1);border:1px solid rgba(74,222,128,.2);color:#86efac;font-size:1.4rem;margin-bottom:22px}.eyebrow{color:#a995ff;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:9px}h1{font-size:clamp(1.9rem,5vw,2.7rem);letter-spacing:-.04em;margin-bottom:10px}.intro{color:#aeb0bb;line-height:1.6;margin-bottom:24px}.note-id{display:flex;align-items:center;gap:10px;padding:15px;border:1px solid rgba(255,255,255,.09);border-radius:15px;background:rgba(10,10,15,.5);margin-bottom:14px;overflow:hidden}.note-id code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:#dddde7;word-break:break-all;flex:1}.copy{flex:0 0 auto;border:1px solid rgba(169,149,255,.2);background:rgba(127,90,240,.1);color:#b8aaff;border-radius:10px;padding:9px 12px;font:inherit;font-size:.82rem;font-weight:700;cursor:pointer}.copy:hover{background:rgba(127,90,240,.18)}.link-box{padding:15px;border-radius:15px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07);color:#aeb0bb;line-height:1.5;margin-bottom:22px}.link-box a{color:#b8aaff;text-decoration:none;word-break:break-all}.link-box a:hover{text-decoration:underline}.actions{display:flex;gap:10px;flex-wrap:wrap}.actions a{min-height:46px;padding:0 17px;border-radius:13px;text-decoration:none;font-weight:700;display:inline-flex;align-items:center;justify-content:center}.primary{background:linear-gradient(135deg,#8b6cff,#6c4fe1);color:#fff;box-shadow:0 10px 24px rgba(127,90,240,.25)}.secondary{background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.1);color:#dedee7}.actions a:hover{transform:translateY(-1px)}a:focus-visible,button:focus-visible{outline:2px solid #a995ff;outline-offset:3px}footer{text-align:center;color:#686a76;font-size:.78rem;margin-top:18px}footer a{color:#9b87ff;text-decoration:none}@media(max-width:560px){.card{border-radius:22px}.actions{display:grid}.actions a{width:100%}.note-id{align-items:stretch;flex-direction:column}.copy{width:100%}}</style>
</head>
<body><main><section class="card"><div class="success-icon" aria-hidden="true">✓</div><div class="eyebrow">Note created</div><h1>Your note is ready.</h1><p class="intro">Save the ID below. You can use it later to retrieve your note.</p><div class="note-id"><code id="note-id"><%= noteId %></code><button class="copy" type="button" onclick="copyToClipboard()">Copy ID</button></div><div class="link-box">Direct link: <a href="/note/<%= noteId %>">/note/<%= noteId %></a></div><div class="actions"><a class="primary" href="/note/<%= noteId %>">Open note →</a><a class="secondary" href="/">Create another</a></div></section><footer>Made with <span aria-hidden="true">♥</span> by <a href="https://Your4Portfolio.vercel.app">YourS4nty</a></footer></main><script>async function copyToClipboard(){const text=document.getElementById('note-id').textContent.trim();const button=document.querySelector('.copy');try{await navigator.clipboard.writeText(text);button.textContent='Copied ✓';setTimeout(()=>button.textContent='Copy ID',1600)}catch(e){const area=document.createElement('textarea');area.value=text;document.body.appendChild(area);area.select();document.execCommand('copy');area.remove();button.textContent='Copied ✓';setTimeout(()=>button.textContent='Copy ID',1600)}}</script></body>
</html>
