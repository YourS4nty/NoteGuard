<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="description" content="Enter the password to unlock a protected NoteGuard note."><link rel="shortcut icon" href="../media/NoteGuard.ico" type="image/x-icon"><title>NoteGuard — Note Locked</title><style>*{box-sizing:border-box;margin:0;padding:0}:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#f8f7ff}body{min-height:100vh;display:grid;place-items:center;padding:20px;background:radial-gradient(circle at 25% 20%,rgba(127,90,240,.2),transparent 35%),radial-gradient(circle at 75% 80%,rgba(98,70,183,.16),transparent 32%),#0b0a10}.card{width:min(460px,100%);padding:clamp(25px,6vw,44px);border:1px solid rgba(255,255,255,.11);border-radius:28px;background:linear-gradient(135deg,rgba(36,38,41,.72),rgba(22,22,26,.55));box-shadow:0 24px 70px rgba(0,0,0,.48),inset 0 1px rgba(255,255,255,.07);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px)}.topbar{display:flex;justify-content:flex-end;margin:-8px -8px 14px}.language{display:flex;gap:4px;padding:5px;border:1px solid rgba(255,255,255,.1);border-radius:12px;background:rgba(255,255,255,.045);color:#9b9daa;font:inherit;font-size:.75rem;cursor:pointer}.language span{padding:5px 7px;border-radius:8px}.language .active{background:rgba(127,90,240,.22);color:#fff}.icon{width:52px;height:52px;display:grid;place-items:center;border-radius:16px;background:rgba(127,90,240,.14);border:1px solid rgba(169,149,255,.22);color:#a995ff;font-size:1.35rem;margin-bottom:22px}.eyebrow{color:#a995ff;font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;margin-bottom:9px}h1{font-size:clamp(1.9rem,5vw,2.5rem);letter-spacing:-.04em;margin-bottom:10px}.intro{color:#aeb0bb;line-height:1.6;margin-bottom:26px}form{display:grid;gap:9px}label{color:#c4c5ce;font-size:.88rem;font-weight:600}input{width:100%;padding:14px;border:1px solid rgba(255,255,255,.09);border-radius:14px;background:rgba(10,10,15,.62);color:#fff;outline:none;font:inherit}input:focus{border-color:rgba(127,90,240,.75);box-shadow:0 0 0 4px rgba(127,90,240,.13)}button{min-height:46px;margin-top:7px;border:0;border-radius:13px;background:linear-gradient(135deg,#8b6cff,#6c4fe1);color:#fff;font:inherit;font-weight:700;cursor:pointer;box-shadow:0 10px 24px rgba(127,90,240,.25);transition:.2s}button:hover{transform:translateY(-1px);box-shadow:0 14px 30px rgba(127,90,240,.34)}button:focus-visible,.language:focus-visible{outline:2px solid #a995ff;outline-offset:3px}footer{text-align:center;color:#686a76;font-size:.78rem;margin-top:18px}footer a{color:#9b87ff;text-decoration:none}</style></head><body><main><section class="card"><div class="topbar"><button class="language" type="button" data-language-toggle onclick="toggleNoteGuardLanguage()" aria-label="Language"><span data-lang-en>EN</span><span data-lang-es>ES</span></button></div><div class="icon" aria-hidden="true">⌁</div><div class="eyebrow" data-i18n="password.eyebrow">Protected note</div><h1 data-i18n="password.title">This note is locked.</h1><p class="intro" data-i18n="password.intro">Enter the password to securely access its contents.</p><form action="/verifyPassword/<%= noteId %>" method="post"><label for="password" data-i18n="password.label">Password</label><input type="password" id="password" name="password" data-i18n-placeholder="password.placeholder" placeholder="Enter note password" autocomplete="current-password" required autofocus><button type="submit"><span data-i18n="password.button">Unlock note</span> <span aria-hidden="true">→</span></button></form></section><footer><span data-i18n="footer.made">Made with</span> <span aria-hidden="true">♥</span> by <a href="https://Your4Portfolio.vercel.app">YourS4nty</a></footer></main><script src="/media/i18n.js"></script></body></html>